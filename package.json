{
  "name": "hermes-tammi-plugin",
  "version": "1.0.0",
  "description": "Tammi (Viettel messenger) platform for Hermes Agent. A Node bridge runs the tammi.vn chat SDK; the Hermes adapter talks to it over HTTP + SSE.",
  "keywords": [
    "tammi",
    "viettel",
    "hermes",
    "hermes-agent",
    "chatbot",
    "zego",
    "zim",
    "bridge",
    "messaging",
    "gateway"
  ],
  "homepage": "https://github.com/cuongdev/hermes-tammi-plugin#readme",
  "bugs": {
    "url": "https://github.com/cuongdev/hermes-tammi-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuongdev/hermes-tammi-plugin.git"
  },
  "license": "MIT",
  "bin": {
    "hermes-tammi-plugin": "bin/cli.mjs"
  },
  "main": "bridge/server.js",
  "files": [
    "bin/",
    "bridge/",
    "scripts/",
    "hermes-plugin/__init__.py",
    "hermes-plugin/adapter.py",
    "hermes-plugin/plugin.yaml",
    "install.mjs",
    "uninstall.mjs",
    "README.md",
    "README.vi.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bridge/server.js",
    "setup": "node install.mjs",
    "uninstall": "node uninstall.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node --test",
    "prepare": "husky",
    "render-assets": "python3 assets/src/render.py"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fake-indexeddb": "^6.2.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9"
  }
}
